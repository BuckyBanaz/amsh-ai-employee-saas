# Copy to .env and fill in real values before running docker-compose.
# `docker compose up -d` reads this via docker-compose.yml's `env_file: .env`
# for the `api` service. After editing .env, restart the api container:
#   docker compose up -d --force-recreate api
#
# Nothing in the "Third-party providers" section is required for `auth` +
# `businesses` + `users` (team invites) to work — those are already real and
# working. These are only needed once the realtime voice engine gets built.

ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://amsh:amsh@postgres:5432/amsh
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Third-party providers ───────────────────────────────────────────────
# Leave any of these blank until you have the real key — the backend reads
# them as optional (backend/common/config.py) and won't crash on startup
# without them. The realtime/voice code that eventually uses each one
# should check for None and fail loudly at the call site, not at boot.

# Twilio — telephony (inbound/outbound calls, media streams)
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Groq — LLM (fast inference) + optionally Whisper STT
# Get this from: https://console.groq.com/keys
GROQ_API_KEY=

# Deepgram — streaming STT (alternative to Groq Whisper)
# Get this from: https://console.deepgram.com
DEEPGRAM_API_KEY=

# ElevenLabs — streaming TTS
# Get this from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Cartesia — streaming TTS (alternative to ElevenLabs, lower latency)
# Get this from: https://play.cartesia.ai/keys
CARTESIA_API_KEY=
