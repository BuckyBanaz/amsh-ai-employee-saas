# Copy to .env and fill in real values before running docker-compose.
# `docker compose up -d` reads this via docker-compose.yml's `env_file: .env`
# for the `api` service. After editing .env, restart the api container:
#   docker compose up -d --force-recreate api
#
# Nothing in the "Third-party providers" section is required for `auth` +
# `businesses` + `users` (team invites) to work â€” those are already real and
# working. These are only needed once the realtime voice engine gets built.

# ENV=production makes the API refuse to start with unsafe settings. DEBUG is for development only.
ENV=development
DEBUG=true

# Comma-free JSON list of browser origins allowed to call the API (defaults to the two local frontends)
# CORS_ORIGINS=["https://app.amsh.ai","https://admin.amsh.ai"]
# POSTGRES_PASSWORD=change-me
# NGROK_DOMAIN=your-subdomain.ngrok-free.dev   (only with `docker compose --profile tunnel up`)

DATABASE_URL=postgresql+psycopg2://amsh:amsh@postgres:5432/amsh
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# â”€â”€ Third-party providers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Leave any of these blank until you have the real key â€” the backend reads
# them as optional (backend/common/config.py) and won't crash on startup
# without them. The realtime/voice code that eventually uses each one
# should check for None and fail loudly at the call site, not at boot.

# Twilio â€” telephony (inbound/outbound calls, media streams)
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Groq â€” LLM (fast inference) + optionally Whisper STT
# Get this from: https://console.groq.com/keys
GROQ_API_KEY=

# Deepgram â€” streaming STT (alternative to Groq Whisper)
# Get this from: https://console.deepgram.com
DEEPGRAM_API_KEY=

# ElevenLabs â€” streaming TTS
# Get this from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Cartesia â€” streaming TTS (alternative to ElevenLabs, lower latency)
# Get this from: https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# Meta WhatsApp Embedded Signup
META_APP_ID=2495665704244136
META_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=amsh_wa_verify_token_2026

# Second LLM provider (fallback when Groq is rate limited). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_PROVIDERS=groq,groq:openai/gpt-oss-120b,gemini,groq:qwen/qwen3.8-27b


# Email (password reset, email verification). Without a key the link is only printed in the API log.
# Get a key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM=AMSh <no-reply@amsh.ai>
FRONTEND_URL=http://localhost:3000

# Exotel (India numbers and SMS)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_PHONE_NUMBER=
# Exotel does not sign webhooks: put this secret in the callback URL as ?key=<secret> (Exotel dashboard applet URL). Use a long random value.
EXOTEL_WEBHOOK_SECRET=

# Which engine answers calls: llm_agent (default) | shadow (agent runs silently beside the old one) | state_machine (old templates, to be retired)
CONVERSATION_ENGINE=llm_agent

# Development helpers that are unsafe with several customers (an unmatched phone call goes to the newest business, and
# older WhatsApp verify tokens are accepted). Set to false in production: the API refuses to start with it on when ENV=production.
ALLOW_DEV_FALLBACKS=true

# Set to 1 to stop the agent from sending real SMS while developing
AMSH_DISABLE_SMS=

# Appointment reminders (message real patients: leave off until the clinic wants them)
REMINDERS_ENABLED=false
REMINDER_INTERVAL_SECONDS=300
